# ─── Commerza Production Environment Configuration ──────────────────────────────
# Copy this file to .env.production before running deployment:
# cp .env.production.example .env.production

# ─── Domain & Public API
DOMAIN=yourdomain.com
NEXT_PUBLIC_API_URL=https://yourdomain.com/api

# ─── Database Credentials (MySQL 8.0)
DB_NAME=commerza
DB_USER=commerza_user
DB_PASSWORD=replace_with_strong_database_password_32char
DB_ROOT_PASSWORD=replace_with_strong_root_password_32char
DB_PORT=3306

# ─── JWT Authentication
JWT_SECRET=replace_with_crypto_random_64_char_secret_key_commerza_auth
JWT_EXPIRY=7d

# ─── Storage Providers (LOCAL, S3, R2)
STORAGE_PROVIDER=LOCAL
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_BUCKET_NAME=
AWS_ENDPOINT= # E.g. https://<accountid>.r2.cloudflarestorage.com for Cloudflare R2

# ─── Payment Gateways (MOCK, STRIPE, RAZORPAY)
PAYMENT_PROVIDER=MOCK
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ─── Email Dispatch (MOCK, SMTP, RESEND)
EMAIL_PROVIDER=MOCK
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
RESEND_API_KEY=
